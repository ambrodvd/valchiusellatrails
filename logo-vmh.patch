From 06187f7ac6e639428daa9cebefaeffef1303e0a2 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Thu, 19 Nov 2026 16:59:13 +0100
Subject: [PATCH] Logo ufficiale VMH in alto a sinistra e come marker dell'Hub
 in mappa

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01UXmXDt4SoNqJWPqVLsWeCW
---
 site/css/style.css    |  10 +++++-----
 site/img/logo-vmh.png | Bin 0 -> 9413 bytes
 site/index.html       |   5 +----
 site/js/app.js        |   2 +-
 4 files changed, 7 insertions(+), 10 deletions(-)
 create mode 100644 site/img/logo-vmh.png

diff --git a/site/css/style.css b/site/css/style.css
index 17714d1..5c4949f 100644
--- a/site/css/style.css
+++ b/site/css/style.css
@@ -36,10 +36,10 @@ svg { flex: none; }
 }
 .topbar > * { pointer-events: auto; }
 .brand {
-  display: flex; align-items: center; gap: 9px; height: 46px; padding: 0 16px 0 6px;
+  display: flex; align-items: center; gap: 9px; height: 46px; padding: 0 16px 0 4px;
   background: var(--ink); color: #fff; border-radius: 999px; text-decoration: none; box-shadow: var(--shadow);
 }
-.brand svg { width: 34px; height: 34px; color: var(--accent); }
+.brand img { width: 38px; height: 38px; display: block; border-radius: 50%; }
 .brand span { font-family: var(--font-head); font-weight: 800; font-size: 16px; letter-spacing: -.01em; white-space: nowrap; }
 .searchbox {
   flex: 0 1 260px; min-width: 0; display: flex; align-items: center; gap: 8px;
@@ -180,10 +180,10 @@ svg { flex: none; }
 
 /* ------------------------------------------------ map markers */
 .hub-pin {
-  width: 40px; height: 40px; border-radius: 12px; background: var(--ink); border: 3px solid #fff;
-  box-shadow: 0 4px 10px rgba(0,0,0,.35); display: grid; place-items: center; transform: rotate(45deg);
+  width: 44px; height: 44px; border-radius: 50%; border: 3px solid #fff; background: #fff;
+  box-shadow: 0 4px 10px rgba(0,0,0,.35); overflow: hidden;
 }
-.hub-pin svg { width: 18px; height: 18px; transform: rotate(-45deg); }
+.hub-pin img { width: 100%; height: 100%; display: block; }
 .start-pin {
   width: 22px; height: 22px; border-radius: 50%; background: var(--c); border: 3px solid #fff;
   box-shadow: 0 2px 5px rgba(0,0,0,.35); display: grid; place-items: center;
diff --git a/site/img/logo-vmh.png b/site/img/logo-vmh.png
new file mode 100644
